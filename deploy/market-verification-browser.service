[Unit]
Description=Resident Shopee and Lazada verification browser for MY Market Radar
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=james
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/opt/google/chrome/chrome --user-data-dir=/home/james/my-market-radar/backend/data/browser-profile --remote-debugging-address=127.0.0.1 --remote-debugging-port=9231 --no-first-run --no-default-browser-check --disable-background-mode https://shopee.com.my/ https://www.lazada.com.my/
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

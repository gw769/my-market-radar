# ═══════════════════════════════════════════════════════════════
#  MY Market Radar · Docker 配置模板
# ═══════════════════════════════════════════════════════════════
# 1. 复制为 .env
# 2. 必须修改 SECRET_KEY，并设置首次管理员 BOOTSTRAP_ADMIN_PASSWORD
# 3. 运行 start_docker.bat 或 docker compose -f docker-compose.simple.yml up -d --build
# 4. 打开 http://localhost:8011

DEFAULT_RESULTS_LIMIT=20
DEFAULT_DAILY_TIME=20:00
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
COLLECTION_TIMEOUT_SECONDS=45

# 运行中采集任务每 10 秒续租；超过 240 秒没有心跳由 watchdog 自动恢复。
RUN_HEARTBEAT_SECONDS=10
RUN_STALE_AFTER_SECONDS=240

# 首次空数据库才会用下面三项创建管理员；已有任何用户时不会再自动创建账户。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@market.my
BOOTSTRAP_ADMIN_PASSWORD=

# 默认不开放任意用户自助注册。只有你明确需要多人注册时才改成 true。
ALLOW_REGISTRATION=false

# 可选：AI 只做严格关键词翻译和聚合公开字段解读；评分始终由规则引擎完成。
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=70
LLM_MAX_RETRIES=5

SECRET_KEY=please-change-me-to-a-random-32-char-string
APP_NAME=MY Marketplace Analyzer
APP_VERSION=1.0.3
DEBUG=false

# 浏览器：Docker 镜像内置 Chromium，普通采集使用 headless CDP。
# 9231 与旧项目的 9223 隔离，避免误连到其他 Chrome 实例。
BROWSER_EXECUTABLE=/usr/bin/chromium
BROWSER_CDP_PORT=9231
BROWSER_HEADLESS_FALLBACK=true

# 默认 SQLite。如果你明确改为 mysql，连接失败时应用默认直接停止，绝不会悄悄切到一个空 SQLite。
# 只有确实希望这种降级行为时，才把 ALLOW_DATABASE_FALLBACK 改成 true。
DATABASE_TYPE=sqlite
ALLOW_DATABASE_FALLBACK=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=marketplace_analyzer

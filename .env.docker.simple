# ═══════════════════════════════════════════════════════════════
#  MY Market Radar · Docker 配置模板
# ═══════════════════════════════════════════════════════════════
#
#  【使用步骤】
#   1. 把本文件复制一份并改名为 .env： copy .env.docker.simple .env
#   2. 打开 .env，按下方标注填写【必填】项，其余保持默认即可
#   3. 双击 start_docker.bat（或执行 docker compose -f docker-compose.simple.yml up -d --build）
#   4. 浏览器打开 http://localhost:8011，默认账号 admin@market.my / admin123
#
#  你不需要安装 MySQL、Redis、Python、Node.js —— 只需要 Docker Desktop。


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  无需平台卖家账号。只读取 Shopee MY 与 Lazada MY 公开搜索页面。
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DEFAULT_RESULTS_LIMIT=20
DEFAULT_DAILY_TIME=20:00
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  【可选】大模型只润色中文文案，不改变评分、不补数据
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 不填也能用（自动降级为内置规则引擎，仍有评分/等级），填了 AI 建议更个性化。
# 推荐 DeepSeek：https://platform.deepseek.com/  →  API Keys → 创建
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  【建议】应用安全密钥（防止他人伪造登录态）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 保持默认也能运行；多人共用同一部署时建议改成随机串。
# 生成命令（需本机有 Python；没有可直接用任意 32 位乱码）：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-32-char-string


APP_NAME=MY Marketplace Analyzer
APP_VERSION=1.0.0
DEBUG=false

# 数据库：默认 SQLite（Docker 已自动持久化到数据卷），无需安装 MySQL
DATABASE_TYPE=sqlite
# 如需要 MySQL，请填写你自己的连接信息（示例值已脱敏，勿照抄）：
MYSQL_HOST=<your-mysql-host>
MYSQL_PORT=<your-mysql-port>
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=marketplace_analyzer
